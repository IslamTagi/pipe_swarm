<?xml version="1.0"?>
<launch>
    <let name="xacro_path" value="$(find-pkg-share pipe_swarm)/urdf/pipe_robot.urdf.xacro" />
    <let name="robot_description" value="$(command 'xacro $(var xacro_path)')" />

    <!-- Start Gazebo Simulator -->
    <include file="$(find-pkg-share gazebo_ros)/launch/gazebo.launch.py" />

    <!-- Load and Publish Robot State Information -->
    <node pkg="robot_state_publisher" exec="robot_state_publisher">
        <param name="robot_description" value="$(var robot_description)" />
    </node>

    <!-- Spawn Robot Entity in Gazebo -->
    <node pkg="gazebo_ros" exec="spawn_entity.py" output="screen"
          args="-topic robot_description -entity pipe_robot" />

    <!-- RViz for Visualization -->
    <node pkg="rviz2" exec="rviz2" output="screen"/>

</launch>