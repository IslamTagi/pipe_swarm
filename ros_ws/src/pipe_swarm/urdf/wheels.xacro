<?xml version="1.0"?>
<robot name="wheels" xmlns:xacro="http://www.ros.org/wiki/xacro">
    
    <xacro:property name="wheel_m" value="0.1" />  <!-- mass /kg -->
    <xacro:property name="wheel_r" value="0.0175" />  <!-- radius /m -->
    <xacro:property name="wheel_l" value="0.01" />  <!-- length /m -->

    <xacro:macro name="wheel_link" params="prefix">
        <link name="${agent_namespace}_wheel_${prefix}_link">
            <visual>
                <origin xyz="0.0 0.0 0.0" rpy="${pi/2} 0.0 0.0"/>
                <geometry>
                    <cylinder radius="${wheel_r}" length="${wheel_l}"/>
                </geometry>
                <material name="wheel">
                    <color rgba="0 0 0 1.0"/>
                </material>
            </visual>
            
            <collision>
                <origin xyz="0.0 0.0 0.0" rpy="${pi/2} 0.0 0.0"/>
                <geometry>
                    <cylinder radius="${wheel_r}" length="${wheel_l}"/>
                </geometry>
            </collision>

            <xacro:cylinder_solid_inertial m="${wheel_m}" r="${wheel_r}" l="${wheel_l}" xyz="0 0 0 " rpy="${pi/2} 0 0"/>
        </link>
    </xacro:macro>

    <!-- LINKS -->
    <xacro:wheel_link prefix="front_right" />
    <xacro:wheel_link prefix="front_left" />
    <xacro:wheel_link prefix="back_right" />
    <xacro:wheel_link prefix="back_left" />

    <!-- JOINTS -->
    <joint name="${agent_namespace}_base_wheel_front_right_joint" type="continuous">
        <origin xyz="${(base_w)/2 - wheel_r} ${-((base_l/2) + (wheel_l/2))} ${-base_h/2}" rpy="0 0 0"/>
        <parent link="${agent_namespace}_base_link"/>
        <child link="${agent_namespace}_wheel_front_right_link"/>
        <axis xyz="0 1 0"/>
    </joint>
    
    <joint name="${agent_namespace}_base_wheel_front_left_joint" type="continuous">
        <origin xyz="${(base_w)/2 - wheel_r} ${(base_l/2) + (wheel_l/2)} ${-base_h/2}" rpy="0 0 0"/>
        <parent link="${agent_namespace}_base_link"/>
        <child link="${agent_namespace}_wheel_front_left_link"/>
        <axis xyz="0 1 0"/>
    </joint>
    
    <joint name="${agent_namespace}_base_wheel_back_right_joint" type="continuous">
        <origin xyz="${-((base_w)/2 - wheel_r)} ${-((base_l/2) + (wheel_l/2))} ${-base_h/2}" rpy="0 0 0"/>
        <parent link="${agent_namespace}_base_link"/>
        <child link="${agent_namespace}_wheel_back_right_link"/>
        <axis xyz="0 1 0"/>
        <mimic joint="${agent_namespace}_base_wheel_front_right_joint" multiplier="1.0"/>
    </joint>

    <joint name="${agent_namespace}_base_wheel_back_left_joint" type="continuous">
        <origin xyz="${-((base_w)/2 - wheel_r)} ${(base_l/2) + (wheel_l/2)} ${-base_h/2}" rpy="0 0 0"/>
        <parent link="${agent_namespace}_base_link"/>
        <child link="${agent_namespace}_wheel_back_left_link"/>
        <axis xyz="0 1 0"/>
        <mimic joint="${agent_namespace}_base_wheel_front_left_joint" multiplier="1.0"/>
    </joint>

    <!-- GAZEBO -->
    <gazebo>
        <plugin name="${agent_namespace}_skid_steer_drive" filename="libgazebo_ros_diff_drive.so">
            <ros>
                <namespace>${agent_namespace}</namespace>
            </ros>
            <!-- Update rate in Hz -->
            <update_rate>50</update_rate> 
            <!-- wheels -->
            <num_wheel_pairs>2</num_wheel_pairs>
             
            <right_joint>${agent_namespace}_base_wheel_front_right_joint</right_joint>
            <right_joint>${agent_namespace}_base_wheel_back_right_joint</right_joint>
            <left_joint>${agent_namespace}_base_wheel_front_left_joint</left_joint>
            <left_joint>${agent_namespace}_base_wheel_back_left_joint</left_joint>
            <!-- kinematics -->
            <wheel_separation>${base_l + wheel_l}</wheel_separation>

            <wheel_diameter>${wheel_r*2}</wheel_diameter>
            <!-- limits -->
            <max_wheel_torque>20</max_wheel_torque>
            <max_wheel_acceleration>1</max_wheel_acceleration>
            <!-- input -->
            <command_topic>cmd_vel</command_topic>
            <!-- output -->
            <odometry_frame>odom</odometry_frame>
            <robot_base_frame>${agent_namespace}_footprint_link</robot_base_frame>
            
            <odometry_topic>odom</odometry_topic>
            <publish_odom>true</publish_odom>
            <publish_odom_tf>true</publish_odom_tf>
            <publish_wheel_tf>true</publish_wheel_tf>
        </plugin>
    </gazebo>    

    <gazebo reference="${agent_namespace}_wheel_front_right_link">
        <material>Gazebo/Black</material>
    </gazebo>
    <gazebo reference="${agent_namespace}_wheel_front_left_link">
        <material>Gazebo/Black</material>
    </gazebo>
    <gazebo reference="${agent_namespace}_wheel_back_right_link">
        <material>Gazebo/Black</material>
    </gazebo>
    <gazebo reference="${agent_namespace}_wheel_back_left_link">
        <material>Gazebo/Black</material>
    </gazebo>

</robot>