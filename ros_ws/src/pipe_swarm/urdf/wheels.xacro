                <param name="min">-2</param>
                <param name="max">2</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        <joint name="base_wheel_back_right_joint">
            <command_interface name="velocity">
                <param name="min">-2</param>
                <param name="max">2</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        <joint name="base_wheel_back_left_joint">
            <command_interface name="velocity">
                <param name="min">-2</param>
                <param name="max">2</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
    </ros2_control> -->

    <gazebo reference="${agent_namespace}_wheel_front_right_link">
        <material>Gazebo/Black</material>
        <mu1 value="1.0"/>
        <mu2 value="0.0"/>
    </gazebo>
    <gazebo reference="${agent_namespace}_wheel_front_left_link">
        <material>Gazebo/Black</material>
        <mu1 value="1.0"/>
        <mu2 value="0.0"/>
    </gazebo>
    <gazebo reference="${agent_namespace}_wheel_back_right_link">
        <material>Gazebo/Black</material>
        <mu1 value="1.0"/>
        <mu2 value="0.0"/>
    </gazebo>
    <gazebo reference="${agent_namespace}_wheel_back_left_link">
        <material>Gazebo/Black</material>
        <mu1 value="1.0"/>
        <mu2 value="0.0"/>
    </gazebo>

</robot>