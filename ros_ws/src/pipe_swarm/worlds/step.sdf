<sdf version="1.7">
  <world name="default">
      <!-- Add the Sun light to the world -->
    <light name='sun' type='directional'>
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 -0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>

    <!-- World settings (using Gazebo defaults implicitly by not specifying a <physics> block) -->
    <gravity>0 0 -9.81</gravity> <!-- Default gravity -->
    <scene>
      <ambient>0.4 0.4 0.4 1.0</ambient> <!-- Use Gazebo's default ambient value -->
      <background>0.7 0.7 0.7 1.0</background> <!-- Use Gazebo's default background -->
      <shadows>1</shadows> <!-- Enable shadows -->
    </scene>

    <physics name="default_physics" default="true" type="ode"> <!-- Use default="true" -->
      <max_step_size>0.001</max_step_size> <!-- Typical default step size -->
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate> <!-- Match max_step_size -->
      <ode>
        <solver>
          <type>quick</type> <!-- 'quick' is common, 'world' is more accurate but slower -->
          <iters>50</iters> <!-- Default iterations -->
          <sor>1.3</sor> <!-- Default SOR parameter -->
          <use_dynamic_moi_rescaling>false</use_dynamic_moi_rescaling> <!-- Usually false -->
        </solver>
        <constraints>
          <!-- Constraint Force Mixing (CFM) and Error Reduction Parameter (ERP) -->
          <!-- These defaults make constraints reasonably stiff -->
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- Add the hollow pipe model -->
    <model name="hollow_pipe">
      <static>true</static>  <!-- Pipe is static, it's not going to move -->
      <pose>-0.2 -0.08 0.08 1.5708 0 1.5708</pose>
      <link name="hollow_pipe_link">
        <visual name="hollow_pipe_visual">
          <geometry>
            <mesh>
              <!-- Path to the hollow pipe mesh -->
              <uri>model://pipe_swarm/models/hollow_pipe/meshes/half_hollow_pipe.stl</uri>
              <scale>0.001 0.001 0.001</scale>  <!-- Scale if needed -->
            </mesh>
          </geometry>
        </visual>

        <collision name="hollow_pipe_collision">
          <geometry>
            <mesh>
              <!-- Path to the hollow pipe mesh for collision -->
              <uri>model://pipe_swarm/models/hollow_pipe/meshes/half_hollow_pipe.stl</uri>
              <scale>0.001 0.001 0.001</scale>  <!-- Scale for collision geometry -->
            </mesh>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.5</mu>   <!-- Increased friction -->
                <mu2>1.5</mu2>  <!-- Increased friction -->
                <slip1>0.0</slip1>
                <slip2>0.0</slip2>
              </ode>
            </friction>
            <contact>
              <ode>
                <kp>1000000.0</kp> <!-- Standard contact stiffness -->
                <kd>100.0</kd>     <!-- Standard contact damping -->
                <max_vel>1.0</max_vel>
                <min_depth>0.001</min_depth>
              </ode>
            </contact>
          </surface>
        </collision>
      </link>
    </model>

    <!-- Add the half hollow pipe model -->
    <model name="half_hollow_pipe">
      <static>true</static>  <!-- Pipe is static, it's not going to move -->
      <pose>4.8 -0.08 0.12 1.5708 0 1.5708</pose>
      <link name="hollow_pipe_link"> <!-- Note: Link name is reused -->
        <visual name="hollow_pipe_visual">
          <geometry>
            <mesh>
              <!-- Path to the hollow pipe mesh -->
              <uri>model://pipe_swarm/models/hollow_pipe/meshes/half_hollow_pipe.stl</uri>
              <scale>0.001 0.001 0.001</scale>  <!-- Scale if needed -->
            </mesh>
          </geometry>
        </visual>

        <collision name="half_hollow_pipe_collision">
          <geometry>
            <mesh>
              <!-- Path to the hollow pipe mesh for collision -->
              <uri>model://pipe_swarm/models/hollow_pipe/meshes/half_hollow_pipe.stl</uri>
              <scale>0.001 0.001 0.001</scale>  <!-- Scale for collision geometry -->
            </mesh>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.5</mu>   <!-- Increased friction -->
                <mu2>1.5</mu2>  <!-- Increased friction -->
                <slip1>0.0</slip1>
                <slip2>0.0</slip2>
              </ode>
            </friction>
            <contact>
              <ode>
                <kp>1000000.0</kp> <!-- Standard contact stiffness -->
                <kd>100.0</kd>     <!-- Standard contact damping -->
                <max_vel>1.0</max_vel>
                <min_depth>0.001</min_depth>
              </ode>
            </contact>
          </surface>
        </collision>
      </link>
    </model>

    <!-- Add the pipe end model -->
    <model name="pipe_end">
      <static>true</static>  <!-- Pipe is static, it's not going to move -->
      <pose>4.8 -0.08 -0.12 1.5708 0 1.5708</pose>
      <link name="hollow_pipe_link"> <!-- Note: Link name is reused -->
        <visual name="hollow_pipe_visual">
          <geometry>
            <mesh>
              <!-- Path to the hollow pipe mesh -->
              <uri>model://pipe_swarm/models/hollow_pipe/meshes/pipe_end.stl</uri>
              <scale>0.001 0.001 0.001</scale>  <!-- Scale if needed -->
            </mesh>
          </geometry>
        </visual>

        <collision name="pipe_end_collision">
          <geometry>
            <mesh>
              <!-- Path to the hollow pipe mesh for collision -->
              <uri>model://pipe_swarm/models/hollow_pipe/meshes/pipe_end.stl</uri>
              <scale>0.001 0.001 0.001</scale>  <!-- Scale for collision geometry -->
            </mesh>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.5</mu>   
                <mu2>1.5</mu2>  
                <slip1>0.0</slip1>
                <slip2>0.0</slip2>
              </ode>
            </friction>
            <contact>
              <ode>
                <kp>1000000.0</kp>
                <kd>100.0</kd>   
                <max_vel>1.0</max_vel>
                <min_depth>0.001</min_depth>
              </ode>
            </contact>
          </surface>
        </collision>
      </link>
    </model>

    <!-- Ground plane (optional) -->
    <model name="ground_plane">
      <static>true</static>
      <link name="ground_plane_link">
        <visual name="ground_plane_visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>10 10</size></plane>
          </geometry>
          <!-- Reverted ground material/surface to implicit defaults -->
        </visual>
        <collision name="ground_plane_collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>10 10</size></plane>
          </geometry>
          <!-- Reverted ground material/surface to implicit defaults -->
          <!-- If you need specific ground friction, add a <surface> block here -->
        </collision>
      </link>
    </model>

  </world>
</sdf>