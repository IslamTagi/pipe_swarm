<?xml version="1.0" ?>
<robot name="mobile_base" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="base_m" value="0.25" />  <!-- mass /kg -->
    <xacro:property name="base_w" value="0.1045" />  <!-- width /m -->
    <xacro:property name="base_l" value="0.055" />  <!-- length /m -->
    <xacro:property name="base_h" value="0.062" />  <!-- height /m -->
    
    <!-- LINKS -->
    
    <link name="${agent_namespace}_base_link">
        <visual>
            <origin xyz="${(base_w*0.5) - 0.02} 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="${base_w} ${base_l} ${base_h}"/>
            </geometry>
            <material name="blue">
                <color rgba="0.86 0.86 0.86 1"/>
            </material>
        </visual>
        
        <collision>
            <origin xyz="${(base_w*0.5) - 0.02} 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="${base_w} ${base_l} ${base_h}"/>
            </geometry>
        </collision>
        
        <xacro:box_inertial m="${base_m}" w="${base_w}" l="${base_l}" h="${base_h}" xyz="${base_w/2 - 0.02} 0 0 " rpy="0 0 0"/>
    </link>
    
</robot>