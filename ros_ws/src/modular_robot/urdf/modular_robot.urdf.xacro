<?xml version="1.0"?>
<robot name="modular_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- Correct include syntax -->
    <xacro:include filename="pipe_robot.xacro"/>

    <!-- Call pipe_robot with agent_namespace -->
    <xacro:pipe_robot agent_namespace="agent_n" include_gazebo="true"/>
    <xacro:pipe_robot agent_namespace="agent_n2" include_gazebo="true"/>
    <xacro:pipe_robot agent_namespace="agent_n3" include_gazebo="true"/>

    <!-- <link name="${agent_namespace}_footprint" /> -->

    <joint name="agent_n_agent_n2_joint" type="fixed">
        <origin xyz="${(0.05+0.02)} 0 0" rpy="0 0 0"/>
        <parent link="agent_n_male_link"/>
        <child link="agent_n2_female_link"/>
    </joint>

    <joint name="agent_n2_agent_n3_joint" type="fixed">
        <origin xyz="${(0.05+0.02)} 0 0" rpy="0 0 0"/>
        <parent link="agent_n2_male_link"/>
        <child link="agent_n3_female_link"/>
    </joint>

    <gazebo>
        <plugin name="ros_control" filename="libgazebo_ros2_control.so">
            <robot_param_node>robot_state_publisher</robot_param_node> 
            <parameters>$(find modular_robot)/config/modular_controller.yaml</parameters>
        </plugin>
    </gazebo>

    <!-- ros2_control Plugin -->
    <ros2_control name="GazeboSystem" type="system">
        <hardware>
            <plugin>gazebo_ros2_control/GazeboSystem</plugin>
        </hardware>
        <joint name="agent_n_female_base_joint">
            <command_interface name="position">
                <param name="min">-pi/2</param>
                <param name="max">pi/2</param>
            </command_interface>
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
        <joint name="agent_n2_female_base_joint">
            <command_interface name="position">
                <param name="min">-pi/2</param>
                <param name="max">pi/2</param>
            </command_interface>
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
        <joint name="agent_n3_female_base_joint">
            <command_interface name="position">
                <param name="min">-pi/2</param>
                <param name="max">pi/2</param>
            </command_interface>
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
    </ros2_control>

</robot>