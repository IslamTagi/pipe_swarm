<?xml version="1.0"?>
<robot name="modular_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="pipe_robot.xacro"/>
    <xacro:include filename="common.xacro"/>
    <xacro:property name="include_gazebo" value="false" />
    
    <link name="footprint_link" />

    <xacro:property name="prismatic_m" value="1.0" />  <!-- mass /kg -->
    <xacro:property name="prismatic_w" value="0.01" />  <!-- width /m -->
    <xacro:property name="prismatic_l" value="0.01" />  <!-- length /m -->
    <xacro:property name="prismatic_h" value="0.01" />  <!-- height /m -->
    <link name="prismatic_link">
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="${prismatic_w} ${prismatic_l} ${prismatic_h}"/>
            </geometry>
        </collision>
        
        <xacro:box_inertial m="${prismatic_m}" w="${prismatic_w}" l="${prismatic_l}" h="${prismatic_h}" xyz="0 0 0 " rpy="0 0 0"/>
    </link>

    <!-- Call pipe_robot with agent_namespace -->
    <xacro:pipe_robot agent_namespace="agent_n" include_gazebo="true" first_link="true"/>
    <xacro:pipe_robot agent_namespace="agent_n2" include_gazebo="true" first_link="false"/>
    <xacro:pipe_robot agent_namespace="agent_n3" include_gazebo="true" first_link="false"/>

    <joint name="footprint_prismatic_joint" type="fixed">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <parent link="footprint_link"/>
        <child link="prismatic_link"/>
    </joint>

    <joint name="prismatic_agent_n_joint" type="prismatic">
        <origin xyz="-0.02 0 0" rpy="0 0 0"/>
        <parent link="prismatic_link"/>
        <child link="agent_n_base_link"/>
        <axis xyz="1 0 0"/>
        <limit lower="-0.3" upper="0.1" effort="100" velocity="0.05"/>
        <dynamics damping="5.0" friction="2.0"/>

    </joint>

    <joint name="agent_n_agent_n2_joint" type="fixed">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <parent link="agent_n_male_link"/>
        <child link="agent_n2_female_link"/>
    </joint>

    <joint name="agent_n2_agent_n3_joint" type="fixed">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <parent link="agent_n2_male_link"/>
        <child link="agent_n3_female_link"/>
    </joint>

    <gazebo>
        <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
            <robot_param_node>robot_state_publisher</robot_param_node> 
            <parameters>$(find modular_robot)/config/modular_controller.yaml</parameters>
        </plugin>
    </gazebo>

    <!-- ros2_control Plugin -->
    <xacro:if value="${include_gazebo}">
        <ros2_control name="GazeboSimSystem" type="system">
            <hardware>
                <plugin>gazebo_ros2_control/GazeboSystem</plugin>
            </hardware>
            <joint name="agent_n2_pivot_base_joint">
                <command_interface name="position">
                    <param name="min">-pi/2</param>
                    <param name="max">pi/2</param>
                </command_interface>
                <state_interface name="position">
                    <param name="initial_value">0.0</param>
                </state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
            </joint>
            <joint name="agent_n3_pivot_base_joint">
                <command_interface name="position">
                    <param name="min">-pi/2</param>
                    <param name="max">pi/2</param>
                </command_interface>
                <state_interface name="position">
                    <param name="initial_value">0.0</param>
                </state_interface>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
            </joint>
            <joint name="prismatic_agent_n_joint">
                <command_interface name="position"/>
                <state_interface name="position">
                    <param name="initial_value">0.0</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
        </ros2_control>
    </xacro:if>

</robot>