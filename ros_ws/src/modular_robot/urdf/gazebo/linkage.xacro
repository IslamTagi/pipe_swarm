<?xml version="1.0"?>
<robot name="gazebo_linkage" xmlns:xacro="http://www.ros.org/wiki/xacro">
    
    <!-- GAZEBO -->
    <gazebo reference="${agent_namespace}_female_link">
        <material>Gazebo/White</material>
    </gazebo>
    <gazebo reference="${agent_namespace}_male_link">
        <material>Gazebo/White</material>
    </gazebo>

    <gazebo>
        <plugin name="${agent_namespace}_control" filename="libgazebo_ros2_control.so">
            <robot_param_node>robot_state_publisher</robot_param_node> 
            <parameters>$(find modular_robot)/config/modular_controller.yaml</parameters>
        </plugin>
    </gazebo>

    <!-- ros2_control Plugin -->
    <ros2_control name="GazeboSystem" type="system">
        <hardware>
            <plugin>gazebo_ros2_control/GazeboSystem</plugin>
        </hardware>
        <joint name="female_base_joint">
            <command_interface name="position">
                <param name="min">-pi/2</param>
                <param name="max">pi/2</param>
            </command_interface>
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
    </ros2_control>

    <!-- <gazebo>
        <plugin name="joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
            <ros>
                <namespace>${agent_namespace}</namespace>
            </ros>
            <update_rate>50</update_rate>
            <joint_name>female_base_joint</joint_name>
        </plugin>
    </gazebo>

    <gazebo>
        <plugin name="${agent_namespace}_control" filename="libgazebo_ros_control.so">
        </plugin>
    </gazebo> -->

</robot>